generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}


// ==========================================
// 1. SEGURIDAD Y ROLES (RBAC SIMPLIFICADO)
// ==========================================

enum RoleName {
  ADMIN
  CAJERO
  ALMACEN
  CONTADOR
}

model Role {
  id          String   @id @default(uuid())
  name        RoleName @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  users User[]

  @@map("roles")
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  isActive     Boolean  @default(true) @map("is_active")
  roleId       String   @map("role_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  role               Role                @relation(fields: [roleId], references: [id])
  sales              Sale[]
  purchases          Purchase[]
  inventoryMovements InventoryMovement[]

  @@map("users")
}

// ==========================================
// 2. CONTACTOS (CLIENTES Y PROVEEDORES)
// ==========================================

model Client {
  id        String   @id @default(uuid())
  name      String
  taxId     String?  @map("tax_id") // NIT / RUC / CI
  email     String?
  phone     String?
  createdAt DateTime @default(now()) @map("created_at")

  sales Sale[]

  @@map("clients")
}

model Supplier {
  id          String   @id @default(uuid())
  companyName String   @map("company_name")
  taxId       String?  @map("tax_id")
  email       String?
  phone       String?
  createdAt   DateTime @default(now()) @map("created_at")

  purchases Purchase[]

  @@map("suppliers")
}

// ==========================================
// 3. CATÁLOGO DE PRODUCTOS E INVENTARIO
// ==========================================

model Category {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  products Product[]

  @@map("categories")
}

model Product {
  id          String   @id @default(uuid())
  categoryId  String   @map("category_id")
  sku         String   @unique
  name        String
  description String?
  costPrice   Decimal  @default(0) @map("cost_price")  // Costo promedio
  salePrice   Decimal  @default(0) @map("sale_price") 
  stock       Decimal  @default(0) 
  minStock    Decimal  @default(0) @map("min_stock") 
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  category           Category            @relation(fields: [categoryId], references: [id])
  saleItems          SaleItem[]
  purchaseItems      PurchaseItem[]
  inventoryMovements InventoryMovement[]

  @@map("products")
}

enum MovementType {
  ENTRADA
  SALIDA
  AJUSTE_POSITIVO
  AJUSTE_NEGATIVO
}

enum MovementReferenceType {
  COMPRA
  VENTA
  MERMA
  AUDITORIA
  INICIAL
}

model InventoryMovement {
  id            String                @id @default(uuid())
  productId     String                @map("product_id")
  userId        String                @map("user_id")
  type          MovementType
  quantity      Decimal               
  unitCost      Decimal               @map("unit_cost") 
  referenceType MovementReferenceType @map("reference_type")
  referenceId   String?               @map("reference_id")
  notes         String?
  createdAt     DateTime              @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@map("inventory_movements")
}

// ==========================================
// 4. VENTAS Y COMPRAS
// ==========================================

enum TransactionStatus {
  PENDIENTE
  COMPLETADO
  ANULADO
}

model Sale {
  id          String            @id @default(uuid())
  clientId    String?           @map("client_id")
  userId      String            @map("user_id")
  status      TransactionStatus @default(COMPLETADO)
  totalAmount Decimal           @map("total_amount") 
  issueDate   DateTime          @default(now()) @map("issue_date")
  createdAt   DateTime          @default(now()) @map("created_at")

  client       Client?       @relation(fields: [clientId], references: [id])
  user         User          @relation(fields: [userId], references: [id])
  items        SaleItem[]

  @@map("sales")
}

model SaleItem {
  id        String  @id @default(uuid())
  saleId    String  @map("sale_id")
  productId String  @map("product_id")
  quantity  Decimal 
  unitPrice Decimal @map("unit_price") 
  subtotal  Decimal 

  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@map("sale_items")
}

model Purchase {
  id          String            @id @default(uuid())
  supplierId  String            @map("supplier_id")
  userId      String            @map("user_id")
  status      TransactionStatus @default(COMPLETADO)
  totalAmount Decimal           @map("total_amount") 
  issueDate   DateTime          @default(now()) @map("issue_date")
  createdAt   DateTime          @default(now()) @map("created_at")

  supplier     Supplier       @relation(fields: [supplierId], references: [id])
  user         User           @relation(fields: [userId], references: [id])
  items        PurchaseItem[]

  @@map("purchases")
}

model PurchaseItem {
  id         String  @id @default(uuid())
  purchaseId String  @map("purchase_id")
  productId  String  @map("product_id")
  quantity   Decimal 
  unitPrice  Decimal @map("unit_price") 
  subtotal   Decimal 

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id])

  @@map("purchase_items")
}